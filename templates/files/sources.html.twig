{# FILES · SOURCES — which module puts a file here, and what it calls one.

   THE TAB EXISTS BECAUSE THE REGISTER CANNOT ANSWER IT. Two installed modules
   may store files and two may not, and the difference is invisible on a list
   of files: a reader asking "why is Roster not here" has nowhere else to look.

   IT READS. Whether a declared source is listed, and the word the hub prints
   for it, are the configure page's Source modules section.

   A LIST TAB, SO NO STRIP: the section's figures are the Overview's. #}
{% extends '@UhifadhiStorage/base.html.twig' %}
{% import '@UhifadhiStorage/files/_table.html.twig' as tbl %}

{% block title %}Files — Sources{% endblock %}

{% block shell_breadcrumbs %}<a href="/">uhifadhi</a> / files / sources{% endblock %}

{% block shell_page_title %}Files{% endblock %}
{% block shell_page_subtitle %}Which module puts a file here, and what it calls it.{% endblock %}

{% block storage_page %}
    {% set here = constant('Uhifadhi\\Storage\\Controller\\FilesSectionController::SOURCES') %}
    {% set base = filter|filter((v, k) => k not in ['state', 'page']) %}
    {% set live = all|filter(r => r.state == 'live')|length %}
    <div class="c" style="margin-bottom:20px">
        <span class="tab">Where a file comes from<span class="src">&middot; {{ all|length }} {{ all|length == 1 ? 'module' : 'modules' }} &middot; {{ live }} of them store</span></span>
        <div class="sxlead">
            <span class="t">{{ ux_icon('shell:info') }}<span><b>A file arrives by being attached to a record.</b> No upload here, no import path &middot; a file carries its record&rsquo;s name for life.</span></span>
        </div>
        {{ tbl.bar(here, filter, tbl.chip(here, 'state', 'Filter by state', [
            {label: 'all', count: all|length, query: base, on: filter.state is not defined},
            {label: 'live', count: live, query: base|merge({state: 'live'}), on: (filter.state ?? null) == 'live'},
            {label: 'none', count: all|length - live, query: base|merge({state: 'none'}), on: (filter.state ?? null) == 'none'},
        ]), 'Find a module') }}
        <table class="tbl">
            <thead><tr><th>Module</th><th>What it calls a file</th><th class="num">Files</th><th class="num">Size</th><th>State</th><th></th></tr></thead>
            <tbody>
            {% for row in rows %}
                <tr>
                    {# THE SLUG, NOT THE COMPOSER PACKAGE. What the hub knows
                       about a module is the name it registered under; nothing
                       on this platform reads a package name, so printing one
                       would be a guess dressed as a fact. #}
                    <td><b>{{ row.label }}</b><div class="mono d" style="font-size:10.5px;margin-top:4px">{{ row.slug }}</div></td>
                    <td>{% if row.fileWord %}<span class="fog">{{ row.fileWord }}</span>{% else %}<span class="fog">stores no files</span>{% endif %}</td>
                    <td class="num">{{ row.state == 'live' ? row.files|number_format : '&mdash;'|raw }}</td>
                    <td class="num">{{ row.state == 'live' ? row.bytes|storage_bytes : '&mdash;'|raw }}</td>
                    <td><span class="chip{{ row.state == 'live' ? ' ok' }}">{{ row.state }}</span></td>
                    <td style="text-align:right">{% if row.state == 'live' and row.files > 0 %}<a class="sxq" href="{{ path(constant('Uhifadhi\\Storage\\Controller\\FilesController::REGISTER')) }}?module={{ row.slug }}">Its files</a>{% else %}<span class="mono d">&mdash;</span>{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="6"><span class="mono d">{{ all is empty ? 'No module stores files, and none is installed that could.' : 'No module matches these filters.' }}</span></td></tr>
            {% endfor %}
            {# UPLOADED IN THE HUB — NEVER, AND BY DESIGN. Drawn as a row so
               that the one thing this surface will not do is stated where a
               reader is already counting what it does. #}
            <tr>
                <td colspan="2"><span class="mono d">Uploaded in the hub</span></td>
                <td class="num">&mdash;</td>
                <td class="num">&mdash;</td>
                <td><span class="chip">never</span></td>
                <td style="text-align:right"><span class="mono d">on the record&rsquo;s page</span></td>
            </tr>
            </tbody>
        </table>
        {{ include('@Shell/_foot.html.twig', {
            count: table.total, noun: 'modules', one: 'module',
            perPage: table.size, page: table.page, pages: table.pages, links: links,
        }, with_context: false) }}
        <div class="sxfoot">
            <span>Removing a module removes its source &middot; its bytes stay where they are</span>
            <span class="sp"></span>
            <a class="tgl" href="{{ path(constant('Uhifadhi\\Storage\\Controller\\FilesConfigureController::SOURCES')) }}">Source modules</a>
        </div>
    </div>

    <div class="grid g2">
        <div class="c">
            <span class="tab">Who may see a file<span class="src">&middot; set by its record</span></span>
            <div class="rln"><span>Who may see it</span><span class="mono d">whoever may see its record</span></div>
            <div class="rln"><span>Who may remove it</span><span class="mono d">whoever the record says</span></div>
            <div class="rln"><span>An incident still in progress</span><span class="mono d">will not let go of its evidence</span></div>
            <div class="rln"><span>A refusal reads as</span><span class="mono acc">not found &mdash; never &ldquo;not allowed&rdquo;</span></div>
        </div>

        <div class="c">
            {% set toldCount = told|filter(l => l.told)|length %}
            <span class="tab">What a module tells this hub<span class="src">&middot; {{ toldCount }} of {{ told|length }} told today</span></span>
            {% for line in told %}
                <div class="rln"><span>{{ line.label }}</span><span class="mono {{ line.told ? 'd' : 'w' }}">{{ line.told ? line.note : 'not told yet' }}</span></div>
            {% endfor %}
            <p class="use">{{ toldCount == told|length ? 'All' : toldCount }} of the {{ told|length }} are told today{% if toldCount < told|length %} &middot; the other {{ told|length - toldCount }} still have to come from each module{% endif %}.</p>
        </div>
    </div>
{% endblock %}
