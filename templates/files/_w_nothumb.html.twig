{# Widget "nothumb" — waiting for a small picture (FL·06).

   STATIC TWIN of files.widgets.js's `nothumb` entry. Rendered by BOTH the hub
   and the widget library.

   A file is kept whether or not its small picture was made. The thumbnail is a
   convenience the platform makes in the background; a photograph the thumbnailer
   cannot read is still there, still downloadable, still evidence. That is why
   this is a queue to watch and not an error to fear. #}
{% import '@UhifadhiStorage/files/_ui.html.twig' as ui %}
{% set queued = waiting|filter(f => f.thumbState.value == 'wait')|length %}
{% set unmade = waiting|filter(f => f.thumbState.value == 'failed')|length %}
<div class="c" data-w="nothumb">
    <span class="tab">Waiting for a small picture<span class="src">&middot; {{ queued }} in the queue &middot; {{ unmade }} could not be made</span></span>
    {% for file in waiting|slice(0, 8) %}
        <div class="rln">
            <span style="display:flex;align-items:center;gap:9px">{{ ui.owner(file) }}<span class="f-note">{{ file.name }}</span></span>
            <span style="display:flex;align-items:center;gap:8px">{{ ui.thumb(file) }}<span class="f-note">{% if file.thumbState.value == 'failed' %}the original is a {{ file.mimeType }}{% else %}arrived <time datetime="{{ file.arrivedAt|date('c') }}" data-localtime-format="daylong">{{ file.arrivedAt|date('D j M Y')|lower }}</time>{% endif %}</span></span>
        </div>
    {% else %}
        <div class="use" style="margin-bottom:0">Every photograph this organization holds has its small picture. Nothing is waiting.</div>
    {% endfor %}
    {# The thumbnail is a convenience made in the background; a photograph the
       thumbnailer cannot read is still there, still downloadable, still evidence.
       Re-making one re-reads the ORIGINAL and writes a new copy beside it. #}
    <div class="use"><b>A file is kept whether or not its small picture was made.</b> A queue to watch, not an error to fear.</div>
</div>
